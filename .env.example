# Copy this file to .env and fill in your key. .env is git-ignored.
#
# The FantasyPros API is optional and DISABLED by default: the free tier
# returns only ten players per position and enforces a very small daily quota.
# The app uses the public HTML projections page instead.
#
# To use a higher-tier key, set FANTASYPROS_USE_API = True in config.py and
# paste the key below.
FANTASYPROS_API_KEY=

# Optional: force a fresh FantasyPros fetch on the next run.
# FANTASYPROS_FORCE_REFRESH=1
